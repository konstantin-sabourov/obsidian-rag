# Copy this to .env and fill in your values
# .env is gitignored — never commit it

# Path to your Obsidian vault (no trailing slash)
VAULT_PATH=/Users/you/path/to/your/vault

# ChromaDB persistence directory (relative to repo root is fine)
CHROMA_PATH=./data/chroma

# Obsidian Local REST API plugin settings
# Port is shown in the plugin settings panel
OBSIDIAN_API_PORT=27123
# API key — set in plugin settings. Leave blank if you disabled auth.
OBSIDIAN_API_KEY=

# Override config.yaml model settings from env if needed (optional)
# EMBEDDING_MODEL=nomic-embed-text
# LLM_MODEL=mistral-nemo